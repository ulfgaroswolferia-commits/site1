{
  "name": "krypta-73-rpg",
  "version": "1.0.6",
  "description": "Krypta 73: Popioły Nowego Świtu — postapokaliptyczna tekstowa gra RPG w terminalu (VS Code / PhpStorm) z interfejsem Pip-Boy 3000.",
  "keywords": [
    "rpg",
    "terminal",
    "cli",
    "game",
    "post-apocalyptic",
    "pip-boy",
    "gra",
    "tekstowa"
  ],
  "type": "module",
  "bin": {
    "krypta73": "bin/krypta73.js"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "tsx src/index.tsx",
    "dev": "tsx watch src/index.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
