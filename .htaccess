<IfModule mod_rewrite.c>

RewriteEngine On

# -----------------------------------------------------------------------------
# Ochrona plików aplikacji i danych. index.php jest jedynym publicznym skryptem.
# Dodaj tu rozszerzenia skryptów obsługiwane przez konfigurację hostingu.
# -----------------------------------------------------------------------------
RewriteRule ^\.well-known/acme-challenge/(?:.*/)?\. - [F,L,NC]
RewriteRule ^\.well-known/acme-challenge(?:/|$) - [S=2]
RewriteRule (^|/)\.well-known(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L,NC]

RewriteRule ^(?:program|views|tests|db|storage|tmp|docs|bin)(?:/|$) - [F,L,NC]
RewriteRule ^(?:cookies\.txt|README\.md|CLAUDE\.md|skills-lock\.json|\.sftpignore|\.gitignore)$ - [F,L,NC]
RewriteRule (?:^|/)[^/]*\.(?:env|ini|conf|config|log|sql|sqlite[0-9a-zA-Z_-]*|db|bak|backup|old|orig|save|swp|dist|sample|pem|key|p12|pfx|crt|cer|csr|yaml|yml|zip|7z|rar|tar|gz|tgz|wal|shm)(?:/|$) - [F,L,NC]
RewriteRule ^(?!index\.php(?:/|$)).*\.(?:php[0-9]*|phtml|phtm?|phar|phps|inc)(?:/.*)?$ - [F,L,NC]

# -----------------------------------------------------------------------------
# Blokada botów / skanerów. Lista do przycięcia lub rozszerzenia per projekt.
# Jeśli serwis MA być indeksowany, usuń z listy bingbot i pokrewne.
# -----------------------------------------------------------------------------
RewriteCond %{HTTP_USER_AGENT} ^.*Go-http-client.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*Bytespider.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*AhrefsBot.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*Barkrowler.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*DataForSeoBot.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*DotBot.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*Mail.RU_Bot.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*MJ12bot.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*SemrushBot.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*SeznamBot.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*SiteAuditBot.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*YandexBot.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*PetalBot.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*Owler.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*BacklinksExtendedBot.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*VelenPublicWebCrawler.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*Timpibot.*$ [NC,OR]
RewriteCond %{HTTP_USER_AGENT} ^.*python-requests.*$ [NC]
RewriteRule .* - [F,L]

# -----------------------------------------------------------------------------
# Wymuszenie HTTPS na produkcji (automatycznie wyklucza środowiska lokalne localhost/127.0.0.1)
# -----------------------------------------------------------------------------
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# -----------------------------------------------------------------------------
# Front controller.
#
# USTAW POD SWÓJ PROJEKT:
#   - aplikacja w katalogu głównym domeny  -> RewriteBase /      i  /index.php
#   - aplikacja w podkatalogu /mojprojekt/ -> RewriteBase /mojprojekt/  i  /mojprojekt/index.php
# -----------------------------------------------------------------------------
RewriteBase /

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule ^(.*)$ /index.php [L,QSA]

</IfModule>

# Nie udostępniaj list plików, jeśli w katalogu nie ma pliku indeksu.
Options -Indexes

# -----------------------------------------------------------------------------
# Bezwzględna ochrona plików wrażliwych na poziomie rdzenia Apache (FilesMatch)
# Działa niezależnie od mod_rewrite (zarówno Apache 2.4, jak i Apache 2.2).
# -----------------------------------------------------------------------------
<FilesMatch "(?i:\.(sqlite[0-9a-zA-Z_-]*|db|env|log|sql|ini|conf|bak|backup|shm|wal|md|lock)$|^data\.php$|^\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Ukryj sygnatury serwera
ServerSignature Off

